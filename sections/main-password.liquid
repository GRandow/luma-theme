{%- comment -%}
  Password page shown while the store is locked: the merchant's message, a
  sign-up form for launch news and the storefront password form.
{%- endcomment -%}

<div class="password color-{{ section.settings.color_scheme }}">
  <div class="password__card">
    <a class="logo" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio | round -%}
        {{
          settings.logo
          | image_url: width: 500
          | image_tag: width: settings.logo_width, height: logo_height, alt: shop.name
        }}
      {%- else -%}
        <span class="logo-mark" aria-hidden="true"></span>
        <span>{{ shop.name | escape }}</span>
      {%- endif -%}
    </a>

    <h1 class="h2">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="text-muted">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'PasswordNewsletter', class: 'password__newsletter' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <label class="visually-hidden" for="PasswordNewsletterEmail">{{ 'newsletter.email_label' | t }}</label>
        <div class="inline-form">
          <input
            id="PasswordNewsletterEmail"
            class="input"
            type="email"
            name="contact[email]"
            autocomplete="email"
            placeholder="{{ 'newsletter.email_placeholder' | t }}"
            required
          >
          <button type="submit" class="button">{{ 'password.notify_me' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="form-message form-message--error">
            {{- form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email -}}
          </p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}

    <div class="password__login">
      <p class="password__divider text-small text-muted">{{ 'password.enter_with_password' | t }}</p>
      {%- form 'storefront_password', class: 'password__form' -%}
        <label class="visually-hidden" for="StorefrontPassword">{{ 'password.password_label' | t }}</label>
        <div class="inline-form">
          <input
            id="StorefrontPassword"
            class="input"
            type="password"
            name="password"
            autocomplete="current-password"
            placeholder="{{ 'password.password_label' | t }}"
            {% if form.errors %}
              aria-invalid="true" aria-describedby="StorefrontPasswordError"
            {% endif %}
          >
          <button type="submit" class="button button--secondary">{{ 'password.enter' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p id="StorefrontPasswordError" class="form-message form-message--error" role="alert">
            {{- 'password.wrong_password' | t -}}
          </p>
        {%- endif -%}
      {%- endform -%}
      <p class="text-small text-muted">{{ 'password.admin_link_html' | t: link: '/admin' }}</p>
    </div>
  </div>
</div>

{% stylesheet %}
  .password {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 2rem var(--page-margin);
  }

  .password__card {
    display: grid;
    gap: 1.25rem;
    width: min(100%, 32rem);
    text-align: center;
  }

  .password__card .logo {
    justify-self: center;
  }

  .password__login {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:defaults.password_heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-4"
    }
  ]
}
{% endschema %}
