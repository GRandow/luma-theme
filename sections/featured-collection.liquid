{%- comment -%}
  Featured collection: a heading and a grid of product cards from one
  collection. Without a collection it shows placeholder cards, so the section
  still previews well in the editor.
{%- endcomment -%}

{%- liquid
  assign collection = section.settings.collection
  assign columns = section.settings.columns_desktop
  assign mobile_columns = section.settings.columns_mobile | plus: 0
  assign mobile_width = 100 | divided_by: mobile_columns
  assign card_sizes = '(min-width: 990px) calc(100vw / ' | append: columns | append: '), (min-width: 750px) 33vw, ' | append: mobile_width | append: 'vw'
-%}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="section-heading">
      <div class="section-heading__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all and collection != blank -%}
        <a class="button button--link" href="{{ collection.url }}">
          {{- 'sections.featured_collection.view_all' | t -}}
          {%- render 'icon', name: 'arrow-right' -%}
        </a>
      {%- endif -%}
    </div>

    <ul
      class="grid"
      role="list"
      style="--columns-desktop: {{ columns }}; --columns-mobile: {{ mobile_columns }};"
    >
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <li>{% render 'product-card', product: product, sizes: card_sizes %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          {%- liquid
            assign placeholder_index = i | modulo: 6 | plus: 1
            assign placeholder_name = 'product-' | append: placeholder_index
          -%}
          <li>
            <div class="product-card">
              <div class="product-card__media">{{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}</div>
              <div class="product-card__info">
                <p class="product-card__title">{{ 'sections.featured_collection.placeholder_title' | t }}</p>
                <div class="price">{{ 4500 | money }}</div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:names.featured_collection",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "t:defaults.featured_collection_eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:defaults.featured_collection_heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:settings.products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:settings.columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:settings.columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:settings.show_view_all",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "t:names.featured_collection",
      "category": "t:categories.products"
    }
  ]
}
{% endschema %}
