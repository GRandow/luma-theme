{%- comment -%}
  Blog: article cards with tag filters (Shopify's /blogs/<blog>/tagged/<tag>
  URLs) and pagination.
{%- endcomment -%}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="section-heading">
      <div class="section-heading__text">
        <h1>{{ blog.title | escape }}</h1>
      </div>
    </div>

    {%- if section.settings.show_tags and blog.all_tags.size > 0 -%}
      <nav class="blog-tags" aria-label="{{ 'blogs.tags_label' | t }}">
        <ul class="blog-tags__list" role="list">
          <li>
            <a
              class="blog-tags__tag"
              href="{{ blog.url }}"
              {% if current_tags == blank %}
                aria-current="page"
              {% endif %}
            >
              {{- 'blogs.all_articles' | t -}}
            </a>
          </li>
          {%- for tag in blog.all_tags -%}
            <li>
              <a
                class="blog-tags__tag"
                href="{{ blog.url }}/tagged/{{ tag | handle }}"
                {% if current_tags contains tag %}
                  aria-current="page"
                {% endif %}
              >
                {{- tag | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- paginate blog.articles by section.settings.articles_per_page -%}
      <ul class="grid blog-grid" role="list" style="--columns-desktop: 3; --columns-mobile: 1;">
        {%- for article in blog.articles -%}
          <li>{% render 'article-card', article: article %}</li>
        {%- else -%}
          <li class="text-muted">{{ 'blogs.no_articles' | t }}</li>
        {%- endfor -%}
      </ul>
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  .blog-tags__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .blog-tags__tag {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .blog-tags__tag[aria-current='page'] {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-background);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "t:settings.articles_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:settings.show_tags",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ]
}
{% endschema %}
