{%- comment -%}
  Search results: the search form, then products, pages and articles that
  match. Product results can be filtered and sorted with the same facets as
  collections (search.filters, search.sort_options).
{%- endcomment -%}

{%- liquid
  assign terms = search.terms
  assign encoded_terms = terms | url_encode
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign clear_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  assign columns = section.settings.columns_desktop
  assign card_sizes = '(min-width: 990px) calc(75vw / ' | append: columns | append: '), (min-width: 750px) 33vw, 50vw'

  assign has_filters = false
  if search.performed and section.settings.enable_filtering and search.filters.size > 0
    assign has_filters = true
  endif
-%}

<script src="{{ 'facets.js' | asset_url }}" type="module"></script>

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <header class="search-page__header">
      <h1>{{ 'search.title' | t }}</h1>
      <form class="search-form search-page__form" action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="SearchPageInput">{{ 'search.label' | t }}</label>
        <input
          id="SearchPageInput"
          class="input search-form__input"
          type="search"
          name="q"
          value="{{ terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
          autocomplete="off"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="button">{{ 'search.submit' | t }}</button>
      </form>
    </header>

    {%- if search.performed -%}
      <facet-filters class="collection" data-section-id="{{ section.id }}">
        {%- paginate search.results by section.settings.results_per_page -%}
          <div class="collection__toolbar">
            {%- if has_filters -%}
              <button
                type="button"
                class="button button--secondary button--small collection__filter-toggle"
                data-dialog-open="FacetsDrawer-{{ section.id }}"
                aria-haspopup="dialog"
                aria-expanded="false"
              >
                {%- render 'icon', name: 'filter' -%}
                {{- 'collections.filters' | t -}}
              </button>
            {%- endif -%}
            <p class="collection__count text-muted" data-facets-update="count" tabindex="-1">
              {{- 'search.results_count' | t: count: search.results_count, terms: terms -}}
            </p>
            {%- liquid
              assign standalone_sort = true
              if has_filters
                assign standalone_sort = false
              endif
            -%}
            {%- render 'sort-by',
              results: search,
              section_id: section.id,
              standalone: standalone_sort,
              action: routes.search_url,
              terms: terms
            -%}
          </div>

          <div class="collection__layout{% if has_filters %} collection__layout--filters{% endif %}">
            {%- if has_filters -%}
              <dialog
                id="FacetsDrawer-{{ section.id }}"
                class="drawer drawer--left facets-drawer"
                aria-labelledby="FacetsHeading-{{ section.id }}"
              >
                <div class="drawer__header">
                  <h2 id="FacetsHeading-{{ section.id }}" class="drawer__title">{{ 'collections.filters' | t }}</h2>
                  <button type="button" class="icon-button" data-dialog-close>
                    <span class="visually-hidden">{{ 'general.close' | t }}</span>
                    {%- render 'icon', name: 'close' -%}
                  </button>
                </div>
                <div class="drawer__body">
                  {%- render 'facets',
                    results: search,
                    section_id: section.id,
                    action: routes.search_url,
                    terms: terms
                  -%}
                </div>
                <div class="drawer__footer" data-facets-update="drawer-footer">
                  <button type="button" class="button button--full" data-dialog-close>
                    {{- 'collections.show_results' | t: count: search.results_count -}}
                  </button>
                </div>
              </dialog>
            {%- endif -%}

            <div class="collection__results" data-facets-update="results">
              {%- render 'active-filters', results: search, clear_url: clear_url -%}

              {%- if search.results_count > 0 -%}
                <ul class="grid" role="list" style="--columns-desktop: {{ columns }}; --columns-tablet: 3;">
                  {%- for item in search.results -%}
                    <li>
                      {%- if item.object_type == 'product' -%}
                        {%- render 'product-card', product: item, sizes: card_sizes -%}
                      {%- else -%}
                        <article class="search-result">
                          <p class="eyebrow">
                            {%- if item.object_type == 'article' -%}
                              {{- 'search.article' | t -}}
                            {%- else -%}
                              {{- 'search.page' | t -}}
                            {%- endif -%}
                          </p>
                          <h3 class="h4 search-result__title">
                            <a class="product-card__link" href="{{ item.url }}">{{ item.title | escape }}</a>
                          </h3>
                          <p class="text-small text-muted">{{ item.content | strip_html | truncatewords: 24 }}</p>
                        </article>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
                {%- render 'pagination', paginate: paginate -%}
              {%- else -%}
                <div class="collection__empty">
                  <p class="h3">{{ 'search.no_results' | t: terms: terms }}</p>
                  <p class="text-muted">{{ 'search.no_results_hint' | t }}</p>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endpaginate -%}
      </facet-filters>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .search-page__header {
    display: grid;
    gap: 1.25rem;
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }

  .search-page__form {
    display: flex;
    gap: 0.5rem;
  }

  .search-page__form .input {
    flex: 1;
  }

  .search-result {
    position: relative;
    display: grid;
    gap: 0.5rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.search_results",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "label": "t:settings.results_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:settings.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:settings.enable_filtering",
      "info": "t:info.filtering",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ]
}
{% endschema %}
