{%- comment -%}
  Not found page: a way back to the catalog and a search box.
{%- endcomment -%}

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width page-width--narrow not-found">
    <p class="eyebrow">404</p>
    <h1>{{ 'not_found.title' | t }}</h1>
    <p class="text-lead text-muted">{{ 'not_found.text' | t }}</p>
    <form class="search-form not-found__search" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="NotFoundSearch">{{ 'search.label' | t }}</label>
      <input
        id="NotFoundSearch"
        class="input"
        type="search"
        name="q"
        placeholder="{{ 'search.placeholder' | t }}"
      >
      <button type="submit" class="button">{{ 'search.submit' | t }}</button>
    </form>
    <a class="button button--link" href="{{ routes.all_products_collection_url }}">
      {{- 'general.continue_shopping' | t -}}
      {%- render 'icon', name: 'arrow-right' -%}
    </a>
  </div>
</div>

{% stylesheet %}
  .not-found {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .not-found__search {
    display: flex;
    gap: 0.5rem;
    width: min(100%, 30rem);
  }

  .not-found__search .input {
    flex: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.not_found",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ]
}
{% endschema %}
