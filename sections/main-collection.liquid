{%- comment -%}
  Collection page: banner, then filters (a sidebar on desktop, a drawer on
  phones), sorting, the product grid and pagination.

  Filtering is server-side storefront filtering: the form is a plain GET
  form, and facets.js re-renders the parts of this section that change
  (`data-facets-update`) through the Section Rendering API.
{%- endcomment -%}

{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign clear_url = collection.url | append: '?sort_by=' | append: sort_by
  assign columns = section.settings.columns_desktop
  assign card_sizes = '(min-width: 990px) calc(75vw / ' | append: columns | append: '), (min-width: 750px) 33vw, 50vw'

  assign has_filters = false
  if section.settings.enable_filtering and collection.filters.size > 0
    assign has_filters = true
  endif

  assign filters_active = false
  for filter in collection.filters
    if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value
      assign filters_active = true
    endif
  endfor
-%}

<script src="{{ 'facets.js' | asset_url }}" type="module"></script>

<div
  class="section color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <header class="collection-banner{% if section.settings.show_image and collection.image %} collection-banner--image{% endif %}">
      <div class="collection-banner__text">
        {%- if section.settings.show_breadcrumbs -%}
          {%- render 'breadcrumbs' -%}
        {%- endif -%}
        <h1>{{ collection.title | escape }}</h1>
        {%- if section.settings.show_description and collection.description != blank -%}
          <div class="rte text-muted collection-banner__description">{{ collection.description }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.show_image and collection.image -%}
        <div class="collection-banner__media media media--landscape">
          {%- render 'image', image: collection.image, sizes: '(min-width: 990px) 40vw, 100vw', priority: true -%}
        </div>
      {%- endif -%}
    </header>

    <facet-filters class="collection" data-section-id="{{ section.id }}">
      {%- paginate collection.products by section.settings.products_per_page -%}
        <div class="collection__toolbar">
          {%- if has_filters -%}
            <button
              type="button"
              class="button button--secondary button--small collection__filter-toggle"
              data-dialog-open="FacetsDrawer-{{ section.id }}"
              aria-haspopup="dialog"
              aria-expanded="false"
            >
              {%- render 'icon', name: 'filter' -%}
              {{- 'collections.filters' | t -}}
            </button>
          {%- endif -%}
          <p class="collection__count text-muted" data-facets-update="count" tabindex="-1">
            {{- 'collections.product_count' | t: count: collection.products_count -}}
          </p>
          {%- if section.settings.enable_sorting -%}
            {%- liquid
              assign standalone_sort = true
              if has_filters
                assign standalone_sort = false
              endif
            -%}
            {%- render 'sort-by',
              results: collection,
              section_id: section.id,
              standalone: standalone_sort,
              action: collection.url
            -%}
          {%- endif -%}
        </div>

        <div class="collection__layout{% if has_filters %} collection__layout--filters{% endif %}">
          {%- if has_filters -%}
            <dialog
              id="FacetsDrawer-{{ section.id }}"
              class="drawer drawer--left facets-drawer"
              aria-labelledby="FacetsHeading-{{ section.id }}"
            >
              <div class="drawer__header">
                <h2 id="FacetsHeading-{{ section.id }}" class="drawer__title">{{ 'collections.filters' | t }}</h2>
                <button type="button" class="icon-button" data-dialog-close>
                  <span class="visually-hidden">{{ 'general.close' | t }}</span>
                  {%- render 'icon', name: 'close' -%}
                </button>
              </div>
              <div class="drawer__body">
                {%- render 'facets', results: collection, section_id: section.id, action: collection.url -%}
              </div>
              <div class="drawer__footer" data-facets-update="drawer-footer">
                <button type="button" class="button button--full" data-dialog-close>
                  {{- 'collections.show_results' | t: count: collection.products_count -}}
                </button>
              </div>
            </dialog>
          {%- endif -%}

          <div class="collection__results" data-facets-update="results">
            {%- render 'active-filters', results: collection, clear_url: clear_url -%}

            {%- if collection.products_count > 0 -%}
              <ul class="grid" role="list" style="--columns-desktop: {{ columns }}; --columns-tablet: 3;">
                {%- for product in collection.products -%}
                  <li>{% render 'product-card', product: product, sizes: card_sizes %}</li>
                {%- endfor -%}
              </ul>
              {%- render 'pagination', paginate: paginate -%}
            {%- else -%}
              <div class="collection__empty">
                {%- if filters_active -%}
                  <p class="h3">{{ 'collections.no_matches' | t }}</p>
                  <a class="button button--secondary" href="{{ clear_url }}" data-facet-link>
                    {{- 'collections.clear_all' | t -}}
                  </a>
                {%- else -%}
                  <p class="h3">{{ 'collections.empty' | t }}</p>
                  <a class="button" href="{{ routes.all_products_collection_url }}">
                    {{- 'general.continue_shopping' | t -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endpaginate -%}
    </facet-filters>
  </div>
</div>

{% stylesheet %}
  .collection-banner {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .collection-banner__description {
    max-width: 42rem;
    margin-top: 0.75rem;
  }

  @media (min-width: 990px) {
    .collection-banner--image {
      grid-template-columns: 1fr 0.8fr;
      align-items: center;
      gap: 3rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_products",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:settings.show_breadcrumbs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:settings.show_description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:settings.show_collection_image",
      "default": false
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:settings.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:settings.enable_filtering",
      "info": "t:info.filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:settings.enable_sorting",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ]
}
{% endschema %}
