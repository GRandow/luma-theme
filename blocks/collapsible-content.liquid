{%- doc -%}
  Accordion row built on <details>, so it opens without JavaScript and is
  announced as expandable by screen readers. Heading and content accept
  dynamic sources: connect them to product metafields (care, sizing,
  shipping) and every product shows its own text from one template.
{%- enddoc -%}

{%- if block.settings.content != blank or request.design_mode -%}
  <details
    class="accordion collapsible-content"
    {% if block.settings.open %}
      open
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <summary class="accordion__summary">
      {%- if block.settings.icon != 'none' -%}
        {%- render 'icon', name: block.settings.icon -%}
      {%- endif -%}
      <span>{{ block.settings.heading | escape }}</span>
      {%- render 'icon', name: 'chevron-down' -%}
    </summary>
    <div class="accordion__content rte">
      {{- block.settings.content -}}
    </div>
  </details>
{%- endif -%}

{% stylesheet %}
  .collapsible-content {
    width: 100%;
  }

  .collapsible-content + .collapsible-content {
    border-top: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collapsible_content",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:defaults.collapsible_heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:settings.content",
      "info": "t:info.dynamic_source",
      "default": "t:html_defaults.collapsible_content"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "none",
          "label": "t:options.icon.none"
        },
        {
          "value": "truck",
          "label": "t:options.icon.truck"
        },
        {
          "value": "return",
          "label": "t:options.icon.return"
        },
        {
          "value": "leaf",
          "label": "t:options.icon.leaf"
        },
        {
          "value": "info",
          "label": "t:options.icon.info"
        },
        {
          "value": "chat",
          "label": "t:options.icon.chat"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "open",
      "label": "t:settings.open_by_default",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:names.collapsible_content",
      "category": "t:categories.text"
    }
  ]
}
{% endschema %}
