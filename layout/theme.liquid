<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {%- render 'meta-tags' -%}
    <script>
      document.documentElement.classList.replace('no-js', 'js');
    </script>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {%- comment -%}
      Preload the fonts the first screen needs. Brand fonts are bundled theme
      assets; fonts from the Shopify library come from fonts.shopifycdn.com.
    {%- endcomment -%}
    {%- if settings.type_brand_fonts -%}
      {{
        'manrope-latin-wght.woff2'
        | asset_url
        | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous'
      }}
      {{
        'dm-sans-latin-wght.woff2'
        | asset_url
        | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous'
      }}
    {%- else -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {%- endif -%}

    {%- render 'css-variables' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script type="importmap">
      {
        "imports": {
          "@theme/utils": "{{ 'utils.js' | asset_url }}",
          "@theme/cart-api": "{{ 'cart-api.js' | asset_url }}"
        }
      }
    </script>
    <script src="{{ 'theme.js' | asset_url }}" type="module"></script>

    {%- render 'structured-data' -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link button" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <div id="LiveRegion" class="visually-hidden" role="status" aria-live="polite"></div>

    <script type="application/json" id="theme-config">
      {
        "routes": {
          "root": {{ routes.root_url | json }},
          "cart": {{ routes.cart_url | json }},
          "cartAdd": {{ routes.cart_add_url | json }},
          "cartChange": {{ routes.cart_change_url | json }},
          "cartUpdate": {{ routes.cart_update_url | json }},
          "predictiveSearch": {{ routes.predictive_search_url | json }},
          "productRecommendations": {{ routes.product_recommendations_url | json }}
        },
        "cartType": {{ settings.cart_type | json }},
        "strings": {
          "cartError": {{ 'cart.error' | t | json }},
          "addedToCart": {{ 'cart.added' | t | json }},
          "cartUpdated": {{ 'cart.updated' | t | json }},
          "variantUnavailable": {{ 'products.unavailable' | t | json }},
          "filtersUpdated": {{ 'collections.filters_updated' | t | json }}
        }
      }
    </script>
  </body>
</html>
