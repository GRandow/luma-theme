{%- doc -%}
  Accessible pagination built from the `paginate` object: previous and next
  links plus page numbers, with the current page marked `aria-current`.
  Links carry `data-facet-link`, so on filtered pages facets.js loads the next
  page without a full reload.

  @param {object} paginate - The `paginate` object from the surrounding {% paginate %} tag

  @example
  {% render 'pagination', paginate: paginate %}
{%- enddoc -%}

{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
    <ul class="pagination__list" role="list">
      {%- if paginate.previous -%}
        <li>
          <a class="pagination__item" href="{{ paginate.previous.url }}" data-facet-link>
            <span class="visually-hidden">{{ 'general.pagination.previous' | t }}</span>
            {%- render 'icon', name: 'chevron-left' -%}
          </a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a class="pagination__item" href="{{ part.url }}" data-facet-link>
              <span class="visually-hidden">{{ 'general.pagination.page' | t }}</span>
              {{- part.title -}}
            </a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="pagination__item" aria-current="page">
              <span class="visually-hidden">{{ 'general.pagination.page' | t }}</span>
              {{- part.title -}}
            </span>
          {%- else -%}
            <span class="pagination__item">{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- if paginate.next -%}
        <li>
          <a class="pagination__item" href="{{ paginate.next.url }}" data-facet-link>
            <span class="visually-hidden">{{ 'general.pagination.next' | t }}</span>
            {%- render 'icon', name: 'chevron-right' -%}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
