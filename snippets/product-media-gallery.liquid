{%- doc -%}
  Product gallery: every media item (images, Shopify-hosted video, YouTube or
  Vimeo, and 3D models shown by their preview image) in a swipeable track
  with thumbnails. The selected variant's image is marked so the gallery can
  open on it; media-gallery.js scrolls to a variant's image when it changes.

  @param {product} product - The product
  @param {string} section_id - Owning section, for unique ids
  @param {boolean} [priority] - Load the first image as the page's main image

  @example
  {% render 'product-media-gallery', product: product, section_id: section.id, priority: true %}
{%- enddoc -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign active_media_id = variant.featured_media.id | default: product.featured_media.id
  assign sizes = '(min-width: 990px) 55vw, 100vw'
  assign gallery_ratio = product.featured_media.preview_image.aspect_ratio | default: 1
-%}

<media-gallery
  class="media-gallery"
  data-active-media-id="{{ active_media_id }}"
  style="--gallery-ratio: {{ gallery_ratio }};"
>
  <ul class="media-gallery__track" role="list" aria-label="{{ 'products.gallery' | t }}" data-track>
    {%- for media in product.media -%}
      <li
        class="media-gallery__item media"
        id="Media-{{ section_id }}-{{ media.id }}"
        data-media-id="{{ media.id }}"
      >
        {%- case media.media_type -%}
          {%- when 'image' -%}
            {%- liquid
              assign load_first = false
              if forloop.first and priority
                assign load_first = true
              endif
            -%}
            {%- render 'image', image: media.preview_image, sizes: sizes, priority: load_first -%}
          {%- when 'video' -%}
            {{
              media
              | video_tag:
                controls: true,
                preload: 'metadata',
                playsinline: true,
                image_size: '1200x',
                class: 'media-gallery__video'
            }}
          {%- when 'external_video' -%}
            {{ media | external_video_tag: class: 'media-gallery__video', loading: 'lazy' }}
          {%- else -%}
            {%- render 'image', image: media.preview_image, sizes: sizes -%}
        {%- endcase -%}
      </li>
    {%- else -%}
      <li class="media-gallery__item media media--square">
        {{- 'product-1' | placeholder_svg_tag: 'placeholder-svg' -}}
      </li>
    {%- endfor -%}
  </ul>

  {%- if product.media.size > 1 -%}
    <ul class="media-gallery__thumbnails" role="list">
      {%- for media in product.media -%}
        <li>
          <button
            type="button"
            class="media-gallery__thumbnail"
            data-target="Media-{{ section_id }}-{{ media.id }}"
            {% if media.id == active_media_id %}
              aria-current="true"
            {% endif %}
          >
            <span class="visually-hidden">
              {{- 'products.show_media' | t: number: forloop.index, total: forloop.length -}}
            </span>
            {%- render 'image', image: media.preview_image, sizes: '80px', alt: '' -%}
            {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
              <span class="media-gallery__play">{% render 'icon', name: 'play' %}</span>
            {%- endif -%}
          </button>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</media-gallery>

{% stylesheet %}
  .media-gallery {
    display: grid;
    gap: 0.75rem;
  }

  .media-gallery__track {
    position: relative;
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .media-gallery__track::-webkit-scrollbar {
    display: none;
  }

  .media-gallery__item {
    flex: 0 0 100%;
    aspect-ratio: var(--gallery-ratio);
    scroll-snap-align: start;
  }

  .media-gallery__item video,
  .media-gallery__item iframe {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border: 0;
  }

  .media-gallery__thumbnails {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.25rem;
  }

  .media-gallery__thumbnail {
    position: relative;
    display: block;
    flex: 0 0 4.5rem;
    width: 4.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-small);
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .media-gallery__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-gallery__thumbnail[aria-current='true'] {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--color-text);
  }

  .media-gallery__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgb(17 17 15 / 0.25);
  }
{% endstylesheet %}
