{%- doc -%}
  Responsive `<img>` with `srcset`, `sizes` and explicit dimensions, so the
  browser downloads the smallest file that fits and reserves the space before
  it loads (no layout shift). Falls back to a Shopify placeholder illustration
  when the image is blank, which keeps editor previews and demo stores tidy.

  Mark the largest image of the first section as `priority`: it is then
  loaded eagerly with `fetchpriority="high"` and preloaded through a `Link`
  header, which is what Largest Contentful Paint needs.

  @param {image} image - Image to render; may be blank
  @param {string} sizes - The `sizes` attribute, e.g. `(min-width: 990px) 50vw, 100vw`
  @param {string} [class] - Classes for the `<img>` element
  @param {string} [alt] - Alternative text; defaults to the image's own alt text. Pass an empty string for decorative images
  @param {boolean} [priority] - Load as the page's main image
  @param {string} [placeholder] - Placeholder illustration name for blank images, such as `product-1` or `lifestyle-2`

  @example
  {% render 'image', image: product.featured_image, sizes: '(min-width: 750px) 25vw, 50vw', class: 'card__image' %}
{%- enddoc -%}

{%- liquid
  if alt == null
    assign alt_text = image.alt | default: ''
  else
    assign alt_text = alt
  endif
  assign widths = '240, 360, 480, 640, 800, 960, 1200, 1440, 1680, 2048'
-%}

{%- if image != blank -%}
  {%- if priority -%}
    {{
      image
      | image_url: width: 2048
      | image_tag:
        widths: widths,
        sizes: sizes,
        class: class,
        alt: alt_text,
        loading: 'eager',
        fetchpriority: 'high',
        preload: true
    }}
  {%- else -%}
    {{
      image
      | image_url: width: 2048
      | image_tag: widths: widths, sizes: sizes, class: class, alt: alt_text, loading: 'lazy'
    }}
  {%- endif -%}
{%- else -%}
  {%- assign placeholder_class = 'placeholder-svg ' | append: class -%}
  {{ placeholder | default: 'image' | placeholder_svg_tag: placeholder_class }}
{%- endif -%}
