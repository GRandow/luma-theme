{%- doc -%}
  Color or pattern swatch. Takes a swatch object (option and filter values
  have one when their colors come from the Color category metafield) or, when
  there is none, a color or image to use instead.

  @param {object} [swatch] - A swatch object with `color` and/or `image`
  @param {object} [color] - Color to use when there is no swatch
  @param {object} [image] - Image to use when there is no swatch
  @param {string} [label] - Visually hidden name, e.g. the color name

  @example
  {% render 'swatch', swatch: value.swatch, label: value.name %}
{%- enddoc -%}

{%- liquid
  assign swatch_image = swatch.image | default: image
  assign swatch_color = swatch.color | default: color
  assign swatch_background = ''
  if swatch_image
    assign swatch_image_url = swatch_image | image_url: width: 64
    assign swatch_background = 'url(' | append: swatch_image_url | append: ')'
  elsif swatch_color
    assign swatch_background = swatch_color
  endif
-%}

<span
  class="swatch"
  {% if swatch_background != blank %}
    style="--swatch-background: {{ swatch_background }};"
  {% endif %}
></span>
{%- if label != blank -%}
  <span class="visually-hidden">{{ label | escape }}</span>
{%- endif -%}
