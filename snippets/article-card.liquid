{%- doc -%}
  Card for a blog article: image, date, title and excerpt. The title link
  covers the card.

  @param {article} article - The article

  @example
  {% render 'article-card', article: article %}
{%- enddoc -%}

<article class="article-card product-card">
  <div class="article-card__media media media--landscape">
    {%- render 'image',
      image: article.image,
      sizes: '(min-width: 990px) 33vw, 100vw',
      alt: '',
      placeholder: 'lifestyle-2'
    -%}
  </div>
  <div class="product-card__info">
    <p class="text-small text-muted">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h2 class="h3 article-card__title">
      <a class="product-card__link" href="{{ article.url }}">{{ article.title | escape }}</a>
    </h2>
    <p class="text-muted">
      {%- if article.excerpt != blank -%}
        {{ article.excerpt | strip_html | truncatewords: 26 }}
      {%- else -%}
        {{ article.content | strip_html | truncatewords: 26 }}
      {%- endif -%}
    </p>
  </div>
</article>
