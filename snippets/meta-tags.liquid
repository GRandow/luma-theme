{%- doc -%}
  Document metadata: charset, viewport, title, description, canonical URL and
  the Open Graph and X (Twitter) cards that link previews use.

  @example
  {% render 'meta-tags' %}
{%- enddoc -%}

{%- liquid
  assign current_tags_text = current_tags | join: ', '
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_type = 'website'

  case request.page_type
    when 'product'
      assign og_type = 'product'
    when 'article'
      assign og_type = 'article'
    when 'password'
      assign og_url = request.origin
  endcase
-%}

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>
  {{- page_title -}}
  {%- if current_tags %} &ndash; {{ 'general.meta.tagged' | t: tags: current_tags_text }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

{%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}
<link rel="canonical" href="{{ canonical_url }}">

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  {%- liquid
    assign og_image_width = page_image.width | at_most: 1200
    assign og_image_height = og_image_width | divided_by: page_image.aspect_ratio | round
  -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: og_image_width }}">
  <meta property="og:image:width" content="{{ og_image_width }}">
  <meta property="og:image:height" content="{{ og_image_height }}">
  <meta property="og:image:alt" content="{{ page_image.alt | default: og_title | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
