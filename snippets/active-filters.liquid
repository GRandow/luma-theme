{%- doc -%}
  Removable chips for the filters in use, built from each filter value's
  `url_to_remove`, plus a link that clears them all.

  @param {object} results - The `collection` or `search` object
  @param {string} clear_url - URL without filters (keeps sorting and search terms)

  @example
  {% render 'active-filters', results: collection, clear_url: clear_url %}
{%- enddoc -%}

{%- liquid
  assign has_active = false
  for filter in results.filters
    if filter.active_values.size > 0
      assign has_active = true
    elsif filter.type == 'price_range'
      if filter.min_value.value or filter.max_value.value
        assign has_active = true
      endif
    endif
  endfor
-%}

<div class="active-filters">
  {%- if has_active -%}
    <ul class="active-filters__list" role="list">
      {%- for filter in results.filters -%}
        {%- for value in filter.active_values -%}
          <li>
            <a class="active-filters__chip" href="{{ value.url_to_remove }}" data-facet-link>
              <span class="visually-hidden">{{ 'collections.remove_filter' | t }}</span>
              {{ filter.label | escape }}: {{ value.label | escape }}
              {%- render 'icon', name: 'close' -%}
            </a>
          </li>
        {%- endfor -%}

        {%- if filter.type == 'price_range' -%}
          {%- if filter.min_value.value or filter.max_value.value -%}
            {%- liquid
              assign price_min = filter.min_value.value | default: 0 | money
              assign price_max = filter.max_value.value | default: filter.range_max | money
            -%}
            <li>
              <a class="active-filters__chip" href="{{ filter.url_to_remove }}" data-facet-link>
                <span class="visually-hidden">{{ 'collections.remove_filter' | t }}</span>
                {{ filter.label | escape }}: {{ price_min }}–{{ price_max }}
                {%- render 'icon', name: 'close' -%}
              </a>
            </li>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      <li>
        <a class="button button--link button--small" href="{{ clear_url }}" data-facet-link>
          {{- 'collections.clear_all' | t -}}
        </a>
      </li>
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .active-filters__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .active-filters__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .active-filters__chip:hover {
    border-color: var(--color-text);
  }

  .active-filters__chip .icon {
    width: 0.875rem;
    height: 0.875rem;
  }
{% endstylesheet %}
